#. module: website_sale_low_stock_urgency
#: model:ir.model.fields,help:website_sale_low_stock_urgency.field_website__low_stock_critical_threshold
msgid "When the sellable quantity is at or below this tighter number, the urgent text is used instead of the regular one. 0 keeps a single text for every badge."
msgstr "Cuando la cantidad vendible sea igual o inferior a este número más estricto, se usa el texto urgente en lugar del habitual. 0 mantiene un único texto para todas las insignias."

#. module: website_sale_low_stock_urgency
#: model_terms:ir.ui.view,arch_db:website_sale_low_stock_urgency.view_website_form_low_stock_urgency
msgid "When to show it"
