#. module: bs_low_stock_urgency
#: model_terms:ir.ui.view,arch_db:bs_low_stock_urgency.view_website_form_low_stock_urgency
msgid "What it says"
msgstr "Что показывает"

#. module: bs_low_stock_urgency
#: model:ir.model.fields,help:bs_low_stock_urgency.field_website__low_stock_critical_threshold
msgid "When the sellable quantity is at or below this tighter number, the urgent text is used instead of the regular one. 0 keeps a single text for every badge."
msgstr "Когда доступное количество равно или ниже этого более строгого числа, используется срочный текст вместо обычного. 0 оставляет единый текст для всех значков."

#. module: bs_low_stock_urgency
#: model_terms:ir.ui.view,arch_db:bs_low_stock_urgency.view_website_form_low_stock_urgency
msgid "When to show it"
msgstr "Когда показывать"

#. module: bs_low_stock_urgency
#: model_terms:ir.ui.view,arch_db:bs_low_stock_urgency.view_website_form_low_stock_urgency
msgid "e.g. Last few"
msgstr "напр. Последние штуки"

#. module: bs_low_stock_urgency
#: model_terms:ir.ui.view,arch_db:bs_low_stock_urgency.view_website_form_low_stock_urgency
msgid "e.g. Only {qty} left"
msgstr "напр. Осталось {qty}"
