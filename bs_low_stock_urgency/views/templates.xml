<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 12.0 has no `assets` manifest key yet: the stylesheet is appended to
         the frontend bundle from a template. -->
    <template id="assets_frontend" inherit_id="website.assets_frontend"
              name="Low Stock Urgency Badges">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/css"
                  href="/bs_low_stock_urgency/static/src/css/low_stock.css"/>
        </xpath>
    </template>

    <!-- The badge itself, in one place. `badge_source` is a product.product
         or a sale.order.line; both answer `_low_stock_badge_values()`, so
         the surfaces cannot disagree about the wording or the number.
         Passed as a `t-set` before the call: body variables stay in the
         caller's scope and never reach the called template. -->
    <template id="low_stock_badge" name="Low Stock Badge">
        <t t-set="badge_values" t-value="badge_source._low_stock_badge_values()"/>
        <span t-if="badge_values['low_stock_badge_text']"
              t-attf-class="o_wslsu_badge {{'o_wslsu_badge_critical' if badge_values['low_stock_badge_critical'] else ''}}"
              t-att-data-low-stock-qty="badge_values['low_stock_badge_qty']"
              role="status"
              t-esc="badge_values['low_stock_badge_text']"/>
    </template>

    <!-- Product page: right under the stock line. Core renders its own empty
         `div.availability_messages` there and fills it from the browser, so
         the badge is placed next to that div rather than inside it.
         12.0 does not expose `combination_info` to the product template,
         only the price fragment builds it, so the badge asks the variant
         the page opens with, which is the one the add-to-cart form posts. -->
    <template id="product_low_stock_badge" inherit_id="website_sale_stock.website_sale_stock_product"
              name="Low Stock Badge on Product">
        <xpath expr="//div[hasclass('availability_messages')]" position="after">
            <div t-if="product_variant" class="o_wslsu_wrap small mt8" role="note">
                <t t-set="badge_source" t-value="product_variant"/>
                <t t-call="bs_low_stock_urgency.low_stock_badge"/>
            </div>
        </xpath>
    </template>

    <!-- Shop grid: under the product name on the tile, above the price. The
         tile speaks for the product's first variant, the one it opens with. -->
    <template id="products_item_low_stock_badge" inherit_id="website_sale.products_item"
              name="Low Stock Badge on Tile">
        <xpath expr="//div[@itemprop='offers']" position="before">
            <div class="o_wslsu_wrap mt-1">
                <t t-set="badge_source" t-value="product"/>
                <t t-call="bs_low_stock_urgency.low_stock_badge"/>
            </div>
        </xpath>
    </template>

    <!-- Cart: 12.0 still renders the cart as a table; the badge goes under
         the quantity cell of the line, below core's stock warning. -->
    <template id="cart_line_low_stock_badge" inherit_id="website_sale.cart_lines"
              name="Low Stock Badge in Cart">
        <xpath expr="//td[hasclass('td-qty')]" position="inside">
            <div class="o_wslsu_wrap mt-1">
                <t t-set="badge_source" t-value="line"/>
                <t t-call="bs_low_stock_urgency.low_stock_badge"/>
            </div>
        </xpath>
    </template>

</odoo>
