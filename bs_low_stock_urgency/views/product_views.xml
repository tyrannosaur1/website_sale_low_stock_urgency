<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Product form: one number per product. 0 is not "off": it hands the
         question to the public category, then to the website. -->
    <record id="product_template_form_view_low_stock_threshold" model="ir.ui.view">
        <field name="name">product.template.form.low.stock.threshold</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group name="low_stock_urgency" string="Website Low Stock Badge">
                    <group>
                        <field name="low_stock_threshold"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Public category: products with 0 inherit these, nearest category
         first, then its parents, then the website. -->
    <record id="product_public_category_form_view_low_stock_threshold" model="ir.ui.view">
        <field name="name">product.public.category.form.low.stock.threshold</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="low_stock_threshold"/>
            </xpath>
        </field>
    </record>

</odoo>
